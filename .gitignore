# Ignore filetypes with these suffixes
*.pyc
*.swp

# Ignore files with these names
.DS_Store
.idea
.buildinfo
.nojekyll

# Ignore folders and their contents with these names
.vscode

# Ignore test, build and distribution files
build/
dist/*.whl
*.egg
*.egg-info/
.pytest_cache/
__pycache__/

# Ignore built documentation files
site/
.cache/

# Ignore local testing directories
local/

# Unconvolved master spectral libraries are small (~25 MB total) and are
# COMMITTED at their delivery paths so they bake into the container image:
#   standard: tetracorder/sl1/usgs/library06.conv/splib06b
#   research: tetracorder/sl1/usgs/rlib06/sprlb06b   (research lib lives in rlib06/)
# At build time the epoch stage convolves these to the instrument grid. See
# docs/superpowers/specs/2026-07-17-multistage-epoch-container-design.md.
# The native-resolution "a" bases are NOT committed (we convolve from "b").
tetracorder/sl1/usgs/rlib06/sprlb06a
tetracorder/sl1/usgs/library06.conv/splib06a

# uv
#uv.lock
#.python-version
.venv

# pixi environments
.pixi/*
!.pixi/config.toml

# Repos
emit-sds-l2b

# Local-only spectral-library archives / staging (never commit; kept for reference)
tetracorder/sl1-archive/
tetracorder/sl1-usgs-new/
**/.DS_Store
